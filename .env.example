# Copy this file to .env and fill in what your instructor gave you.
# Environment variables with the same names override this file.

# --- MongoDB Atlas ---------------------------------------------------------
# Your personal connection string. Your database user can only read and write
# your own database, stays_<ATTENDEE>.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
ATTENDEE=your_name
# DB_NAME=stays_your_name      # optional: overrides the stays_<ATTENDEE> default

# Voyage AI model used by the automated-embedding index (v3).
EMBED_MODEL=voyage-4

# --- LLM for the concierge (Lab 4) -----------------------------------------
# Any OpenAI-compatible endpoint: OpenAI, Azure OpenAI, the workshop proxy, Ollama...
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# ...or Anthropic instead:
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=auto            # auto | openai | anthropic | none

# --- App -------------------------------------------------------------------
PORT=8080
# RESEED=true                  # drop and reload the hotels on startup
# AUTO_CREATE_INDEXES=true     # create both search indexes at startup (instructor demo)
